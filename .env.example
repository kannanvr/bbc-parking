# SMTP (Gmail example: create an "App password" in your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=association@example.com
SMTP_PASS=your-app-password
MAIL_FROM="BBC City Park Association <association@example.com>"

# Association mail that is copied on every notice
ASSOCIATION_EMAIL=association@example.com

# Parking charge shown in the mail (leave blank to omit)
PARKING_CHARGE=Rs. 500

# Optional: code that the security staff must type in (blocks misuse by outsiders)
ACCESS_CODE=

# Code needed to open /report (set this, otherwise the report stays locked)
REPORT_CODE=

# Added automatically by the Neon integration on Vercel; for local use copy it from the Neon dashboard
DATABASE_URL=
